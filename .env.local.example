# Supabase 프로젝트 설정 → API 메뉴에서 확인
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# 카카오/구글은 Supabase 대시보드 Authentication > Providers 에서 활성화.
# 네이버는 Supabase 기본 제공 provider가 아니라서 /api/auth/naver/* 의 OAuth2 브릿지로 별도 구현함 (아래 NAVER_* 참고).

# AI 최종 선택 단계 (STEP 9) — 없으면 결정론적 스코어링 1위를 그대로 사용
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# STEP 10: Web Push용 VAPID 키. 아래 명령으로 한 번 생성:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:hello@example.com

# 서버 전용 — 크론이 모든 사용자 데이터를 다룰 때 사용 (절대 클라이언트에 노출 금지)
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# 크론 엔드포인트 보호용 임의의 비밀값 (Authorization: Bearer <값> 로 검증)
CRON_SECRET=YOUR_RANDOM_SECRET

# 네이버 로그인 (STEP 3 잔여 과제 — OAuth2 브릿지 방식, /api/auth/naver/* 참고)
# 네이버 개발자센터(developers.naver.com)에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=YOUR_NAVER_CLIENT_ID
NAVER_CLIENT_SECRET=YOUR_NAVER_CLIENT_SECRET
# 등록한 서비스 URL의 Callback URL은 반드시 {서비스 도메인}/api/auth/naver/callback 으로 설정

# 관리자 화면 접근을 허용할 이메일 목록 (쉼표로 구분)
ADMIN_EMAILS=admin@example.com
